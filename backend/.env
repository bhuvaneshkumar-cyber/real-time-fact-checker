# Environment variables for Real-Time Fact Checker Backend
# Copy this file to .env and fill in the values

# Server settings
HOST=0.0.0.0
PORT=8001

# LLM provider selection: ollama, or nim
LLM_PROVIDER=ollama

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=2048

# NVIDIA NIM settings (OpenAI-compatible)
# Get your NIM API key from https://build.nvidia.com/
NIM_API_KEY=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
NIM_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Tavily Search API settings (only used if USE_SEARCH=true)
TAVILY_API_KEY=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
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=advanced

# Enable/disable search functionality
# Set to "true" to use external search (requires TAVILY_API_KEY)
# Set to "false" to rely solely on LLM knowledge (faster, good for real-time)
USE_SEARCH=true

# Extension ID (optional, for stricter CORS)
# EXTENSION_ID=your_chrome_extension_id_here

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# LLM performance tuning
LLM_MAX_CONCURRENCY=2
LLM_EXTRACT_MAX_TOKENS=512
LLM_CLASSIFY_MAX_TOKENS=150
